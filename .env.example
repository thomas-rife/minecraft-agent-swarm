# Minecraft Server
MC_HOST=localhost
MC_PORT=25565
MC_USERNAME=Milo
MC_USERNAME_2=Ava
MC_USERNAME_3=Peter
MC_VERSION=1.21.4
MC_AUTH=offline

# Ollama (local LLM)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3.6:35b-a3b     # MoE — 35B-class quality at ~150 tok/s; used for ALL decisions
OLLAMA_FAST_MODEL=qwen3.6:35b-a3b # Same model: avoids VRAM eviction thrash between two models
OLLAMA_CONTEXT_LENGTH=32768

OLLAMA_REQUEST_TIMEOUT_MS=90000  # Starts after this process's CPU-only LLM queue reaches the request

# Twitch (optional - for chat integration)
TWITCH_CHANNEL=your_channel_name
TWITCH_BOT_USERNAME=your_bot_username
TWITCH_OAUTH_TOKEN=oauth:your_token_here

# YouTube (optional - for chat integration)
YOUTUBE_VIDEO_ID=your_live_video_id

# Bot Settings
BOT_NAME=Milo
BOT_DECISION_INTERVAL_MS=500     # Legacy: minimum gap between decisions (used as floor)
BOT_IDLE_INTERVAL_MS=10000       # Event-driven brain: strategic re-plan interval (ms)
BOT_CRITIC_ENABLED=true          # Enable critic step after each action (extra LLM call)
ENABLE_DYNAMIC_SKILLS=false      # Keep Voyager/generated skills off until they have verified contracts
BOT_CHAT_COOLDOWN_MS=3000

# Multi-bot mode
ENABLE_MULTI_BOT=true    # Default: run the full three-bot team
BOT_COUNT=3              # 1=Milo, 2=+Ava, 3=+Peter (values above 3 are capped)

# Logging
LOG_LEVEL=info           # debug | info | warn | error (debug shows full LLM prompts/responses)
# DEBUG=true             # Shortcut for LOG_LEVEL=debug
DIAGNOSTIC_LOG_ENABLED=true      # Compact JSONL timeline in logs/diagnostics/
DIAGNOSTIC_SUMMARY_MINUTES=5     # Aggregate routine outcomes instead of logging every action
DIAGNOSTIC_MAX_MB=5              # Rotate each diagnostic file at this size
TRAJECTORY_LOG_MODE=off          # off | failures | all; full prompts can be very large
